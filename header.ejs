<!-- TODO: Implement the site header here -->

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= title || "DealFinder" %></title>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Roboto:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/static/style.css" />
</head>
<body>
  <header class="header">
    <div class="top-left"><a class="logo" href="/">DealFinder</a></div>

    <div class="top-middle">
      <!-- unfinish search filters -->
      <form action="/" method="get">
        <input class="search-bar" name="q" value="<%= q || '' %>" placeholder="Search deals" />
        <select class="nav-select" name="store">
          <option value="">All Stores</option>
          <option <%= store==='BestBuy'?'selected':'' %>>BestBuy</option>
          <option <%= store==='Target'?'selected':'' %>>Target</option>
          <option <%= store==='Costco'?'selected':'' %>>Costco</option>
        </select>
      </form>
    </div>

    <div class="top-right">
      <a class="nav-btn" href="/watchlist">Watchlist</a>
      <button class="light-mode-toggle" title="Toggle theme">☀</button>
    </div>
  </header>
