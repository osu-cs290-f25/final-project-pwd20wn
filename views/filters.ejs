<div class="top-middle">
  
  <input class="search-bar" type="text" placeholder="Search deals...">
  <button id="search-button" style="display:none;"></button>

  <select class="nav-select" id="store-filter">
    <option value="">Stores</option>
    <option value="Amazon">Amazon</option>
    <option value="Costco">Costco</option>
    <option value="BestBuy">Best Buy</option>
    <option value="Target">Target</option>
    <option value="Walmart">Walmart</option>
  </select>

  <select class="nav-select" id="category-filter">
    <option value="">Category</option>
    <option value="Apparel">Apparel</option>
    <option value="Automotive">Automotive</option>
    <option value="Electronics">Electronics</option>
    <option value="Gaming">Gaming</option>
    <option value="HomeGoods">Home Goods</option>
  </select>

  <select class="nav-select" id="rating-filter">
    <option value="">Deal Rating</option>
    <option value="5">5 Stars</option>
    <option value="4">4 Stars</option>
    <option value="3">3 Stars</option>
    <option value="2">2 Stars</option>
  </select>

  <select class="nav-select" id="price-filter">
    <option value="0">Price</option>
    <option value="25">Under $25</option>
    <option value="50">Under $50</option>
    <option value="100">Under $100</option>
    <option value="101">Over $100</option>
  </select>

  <select class="nav-select" id="sort-order">
    <option value="dealScore">Sort by: Deal Score</option>
    <option value="price">Sort by: Price</option>
    <option value="endingSoon">Sort by: Ending Soon</option>
  </select>
</div>