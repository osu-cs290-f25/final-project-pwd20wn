<!-- Iterate over the 'watchlist' array and display them -->
<%- include('partials/header', { title: 'Watchlist' }) %>

<main class="deals grid">
  <% if (!deals || deals.length === 0) { %>
    <p style="padding:20px;color:var(--muted)">Your watchlist is empty.</p>
  <% } %>

  <% (deals || []).forEach(d => { %>
    <%- include('partials/deal-card', { d }) %>
  <% }) %>
</main>

<%- include('partials/footer') %>
